<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GNSS / Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Accelerometer sensor (no permission needed for standard sensors) -->

    <!-- BLE (Tesla direct connection) — Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />

    <!-- BLE — Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Foreground service for trip recording -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep screen on while dashboard is active -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- BLE feature declaration (not required, but recommended) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".app.DashboardApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeslaDashboard"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:theme="@style/Theme.TeslaDashboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.history.HistoryActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <!-- 设置二级页 (安卓分级结构) -->
        <activity
            android:name=".ui.settings.BleSettingsActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.settings.AppearanceSettingsActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.settings.LanguageSettingsActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.settings.UnitSettingsActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.settings.AboutActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <activity
            android:name=".ui.pairing.PairingActivity"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false" />

        <service
            android:name=".service.TripRecordingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- 应用内语言选择的自动存储服务 (API 26-32 冷启动恢复语言) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- FileProvider: 分享诊断日志 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
