<?xml version="1.0" encoding="utf-8"?>
<!--
    Dash for Tesla 风格深色氛围背景

    层次:
    1. 底层: 深蓝黑渐变 (#0A0A1A → #0D0D1F → #050508)
    2. 中层: 底部地形剪影 (暗色波浪)
    3. 上层: 微弱顶部光晕 (cyan/blue, 5% 透明度)

    模仿 Dash for Tesla 的 bg_car_h.png + default_bg 风格
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== 1. 底层渐变背景 ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0D0D1F"
                android:centerColor="#0A0A18"
                android:endColor="#050508"
                android:type="linear" />
        </shape>
    </item>

    <!-- ===== 2. 顶部微弱光晕 ===== -->
    <item android:top="-50dp">
        <shape android:shape="oval">
            <solid android:color="#100A2E" />
            <size
                android:width="400dp"
                android:height="200dp" />
        </shape>
    </item>

    <!-- ===== 3. 底部地形剪影 (第一层, 较远) ===== -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#100D1A"
                android:endColor="#1A1525"
                android:type="linear" />
        </shape>
    </item>

    <!-- ===== 4. 底部地形剪影 (第二层, 较近) ===== -->
    <item android:bottom="0dp" android:left="-20dp" android:right="-20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#080812"
                android:endColor="#0F0F1A"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
