<?xml version="1.0" encoding="utf-8"?>
<!--
    启动动画 — 眼睛淡入 + 左眼眨眼 (总时长 ~1s)
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_eyes">

    <!-- 整体淡入 -->
    <target
        android:name="eyesWhole"
        android:animation="@animator/splash_eyes_fade_in" />

    <!-- 左眼眨眼 -->
    <target
        android:name="leftEye"
        android:animation="@animator/splash_eye_blink" />

</animated-vector>
