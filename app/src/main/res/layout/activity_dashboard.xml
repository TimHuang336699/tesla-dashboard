<?xml version="1.0" encoding="utf-8"?>
<!--
    Dashboard 主界面布局 — Dash for Tesla 风格 (横屏 landscape)

    三列布局结构:
    ┌──────────────────────────────────────────────────────────┐
    │  档位 P                              78%  320km          │  ← 顶部栏
    │ ──────────────────────────────────────────────────────── │
    │                                                            │
    │ ┌─────────┐  ◀              ┌─────────┐                  │
    │ │         │  ┌────────────┐  │   78%   │                  │
    │ │   88    │  │      ◀ ▶   │  │  ████   │                  │
    │ │  km/h   │  └────────────┘  │  ████   │                  │
    │ │  READY  │  ┌────────────┐  │  ████   │                  │
    │ │         │  │     🚗     │  │         │                  │
    │ └─────────┘  └────────────┘  └─────────┘                  │
    │                                                            │
    │ ●BLE已连接 12.5km 1.2G N35° E120°  ●●●  历史 ⚙         │  ← 底部栏
    └──────────────────────────────────────────────────────────┘

    设计要点:
    - 深色氛围背景 (bg_dashboard_atmosphere)
    - 左列: SpeedDisplayView (大号速度数字 + km/h 单位 + READY 状态)
    - 中列: TurnSignalView + CarSilhouetteView (速度环已删除)
    - 右列: VerticalGaugeView (竖向电量仪表)
    - 底部: 连接状态 + 行程数据 + 指示灯条 + 按钮
    - 主题颜色由 ThemeManager 在代码中实时应用
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_atmosphere"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- ================================================================ -->
    <!-- ===== Guidelines: 三列分界线 ===== -->
    <!-- ================================================================ -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.22" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.85" />

    <!-- ================================================================ -->
    <!-- ===== 顶部栏: 档位(左) + 电量(右) ===== -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 档位 (左, 大号粗体, 强调色) -->
        <TextView
            android:id="@+id/gearText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:text="@string/default_value"
            android:textColor="@color/accent_blue"
            android:textSize="28sp" />

        <!-- 弹性间隔 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- 电量信息列 (右, 右对齐) -->
        <LinearLayout
            android:id="@+id/batteryColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <!-- 电量百分比 (大号细体) -->
            <TextView
                android:id="@+id/socText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <!-- 续航里程 (小号) -->
            <TextView
                android:id="@+id/rangeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 顶部分隔线 -->
    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================================================================ -->
    <!-- ===== 左列: 速度数字显示 (SpeedDisplayView, 原 AP 状态位置) ===== -->
    <!-- ================================================================ -->
    <com.tesla.dashboard.ui.dashboard.SpeedDisplayView
        android:id="@+id/speedDisplay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="8dp"
        app:sdvMaxSpeed="240"
        app:sdvSpeed="0"
        app:sdvUnit="km/h"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/centerGuide" />

    <!-- ================================================================ -->
    <!-- ===== 中列: 转向灯 + 车辆剪影 (速度环已删除) ===== -->
    <!-- ================================================================ -->

    <!-- 转向灯 (居中, 顶部) -->
    <com.tesla.dashboard.ui.dashboard.TurnSignalView
        android:id="@+id/turnSignals"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintStart_toStartOf="@id/centerGuide"
        app:layout_constraintEnd_toStartOf="@id/rightGuide" />

    <!-- 锁定状态图标 (屏幕正中间上方, 车辆剪影正上方) -->
    <ImageView
        android:id="@+id/ivLockStatus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Lock status"
        android:src="@drawable/ic_lock_status"
        app:layout_constraintTop_toBottomOf="@id/turnSignals"
        app:layout_constraintStart_toStartOf="@id/centerGuide"
        app:layout_constraintEnd_toStartOf="@id/rightGuide" />

    <!-- 车辆俯视剪影 (中列居中, 放大尺寸) -->
    <com.tesla.dashboard.ui.dashboard.CarSilhouetteView
        android:id="@+id/carSilhouette"
        android:layout_width="220dp"
        android:layout_height="140dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/ivLockStatus"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="@id/centerGuide"
        app:layout_constraintEnd_toStartOf="@id/rightGuide"
        app:layout_constraintVertical_bias="0.5" />

    <!-- ================================================================ -->
    <!-- ===== 右列: 竖向电量仪表 (VerticalGaugeView) ===== -->
    <!-- ================================================================ -->
    <com.tesla.dashboard.ui.dashboard.VerticalGaugeView
        android:id="@+id/verticalGauge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp"
        app:vgLabel="SOC"
        app:vgMaxValue="100"
        app:vgValue="0"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="@id/rightGuide"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================================================================ -->
    <!-- ===== 底部栏: 状态(左) + 数据(中) + 指示灯(中右) + 按钮(右) ===== -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/detailSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 左侧: BLE 连接状态 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/teslaDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_orange" />

            <TextView
                android:id="@+id/teslaStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tesla_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 中间: 行程数据 (弹性居中) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tripDistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/gForceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/latText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/headingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-thin"
                android:text="@string/default_value"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 中右: 指示灯条 (BLE/GPS/罗盘) -->
        <com.tesla.dashboard.ui.dashboard.IndicatorStripView
            android:id="@+id/indicatorStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:isvIndicatorSize="16dp"
            app:isvIndicatorSpacing="12dp" />

        <!-- 右侧: 历史 + 设置按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="历史"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- ===== 可展开详情区 (默认隐藏) ===== -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/detailSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_surface_rounded"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_temperature"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-thin"
            android:text="@string/default_value"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_odometer"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/odoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-thin"
            android:text="@string/default_value"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/batteryBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent_green"
            android:progressBackgroundTint="@color/divider" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
