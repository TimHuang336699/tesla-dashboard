<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页面布局 — BLE 蓝牙直连版,苹果式简约设计,横屏全屏

    布局结构:
    1. 顶部标题栏: 返回箭头 + "Settings" 标题
    2. 双列卡片区域(适配横屏):
       - 左列: Tesla BLE 配置卡(VIN + 配对状态 + 配对/测试/解绑按钮)
       - 右列: 车辆信息卡(车型) + 外观卡(主题)
    3. 所有设置项修改后即时自动保存(无保存按钮)

    设计风格: 苹果式简约
    - 深色背景 (#0A0E14)
    - 圆角卡片 (16dp radius, 1px 描边)
    - 扁平无阴影
    - Material3 OutlinedBox 输入框
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- ===== 顶部标题栏 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- 返回按钮 -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_settings"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_cyan" />

            <!-- 标题 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_settings"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- ===== 双列卡片区域(适配横屏) ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- ===== 左列: Tesla BLE 配置 ===== -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <!-- 卡片1: Tesla BLE -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTeslaBle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 分区标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="@string/settings_tesla_ble"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- VIN 输入框 -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVin"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="@string/settings_vin"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/accent_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:inputType="textCapCharacters"
                                android:maxLength="17"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- 配对状态标签 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="@string/settings_pairing_status"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- 配对状态值 -->
                        <TextView
                            android:id="@+id/tvPairingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_not_paired"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <!-- 配对进度文字 -->
                        <TextView
                            android:id="@+id/tvPairingProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <!-- 配对车辆按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPair"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="@string/settings_pair_vehicle"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accent_cyan"
                            app:cornerRadius="12dp" />

                        <!-- 测试连接按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="@string/settings_test_connection"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/accent_green"
                            app:strokeWidth="1.5dp" />

                        <!-- 解除配对按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnpair"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="@string/settings_unpair_vehicle"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== 右列: 车辆信息 + 外观 ===== -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <!-- 卡片2: 车辆信息 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 分区标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="@string/settings_vehicle"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- 车型选择(下拉) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBatteryModel"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/settings_battery_model"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/accent_cyan"
                            app:endIconTint="@color/text_secondary">

                            <AutoCompleteTextView
                                android:id="@+id/actvBatteryModel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:inputType="none"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 卡片3: 外观 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 分区标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="@string/settings_appearance"
                            android:textColor="@color/accent_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- 主题选择标签 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="@string/settings_theme"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- 主题选择 RadioGroup -->
                        <RadioGroup
                            android:id="@+id/rgTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbThemeDark"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/accent_cyan"
                                android:fontFamily="sans-serif-medium"
                                android:minWidth="0dp"
                                android:minHeight="36dp"
                                android:paddingStart="8dp"
                                android:text="@string/settings_theme_dark"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbThemeLight"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/accent_cyan"
                                android:fontFamily="sans-serif-medium"
                                android:minWidth="0dp"
                                android:minHeight="36dp"
                                android:paddingStart="8dp"
                                android:text="@string/settings_theme_light"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbThemeSystem"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/accent_cyan"
                                android:checked="true"
                                android:fontFamily="sans-serif-medium"
                                android:minWidth="0dp"
                                android:minHeight="36dp"
                                android:paddingStart="8dp"
                                android:text="@string/settings_theme_system"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                        </RadioGroup>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
